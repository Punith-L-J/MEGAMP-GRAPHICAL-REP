/* ============================================
   MEGAMP Q: UNIVERSAL DESIGN SYSTEM v4.0
   Industrial OS - Professional Aesthetic
   ============================================ */

:root {
  /* CORE COLOR PALETTE */
  --bg-primary: #0A0A0A;
  --bg-secondary: #050505;
  --bg-tertiary: #0F0F0F;
  --bg-deep: #050505;
  --bg-panel: rgba(13, 13, 17, 0.85);
  
  /* PRIMARY & ACCENTS */
  --primary: #FF5722;
  --primary-bright: #FF7043;
  --primary-dark: #E64A19;
  --primary-glow: rgba(255, 87, 34, 0.3);
  --primary-glow-bright: rgba(255, 87, 34, 0.6);
  
  /* SECONDARY ACCENTS */
  --accent: #00F2FF;
  --accent-glow: rgba(0, 242, 255, 0.3);
  --accent-dark: #00D4FF;
  
  /* STATUS COLORS */
  --success: #00FF41;
  --success-dark: #00E535;
  --success-glow: rgba(0, 255, 65, 0.3);
  --warning: #FFAB00;
  --warning-glow: rgba(255, 171, 0, 0.2);
  --error: #FF073A;
  --error-dark: #E60330;
  --error-glow: rgba(255, 7, 58, 0.2);
  
  /* TYPOGRAPHY */
  --text-main: #FFFFFF;
  --text-secondary: #E0E0E0;
  --text-dim: #888899;
  --text-dimmer: #666677;
  
  /* BORDERS & GLASS */
  --border: rgba(255, 255, 255, 0.08);
  --border-bright: rgba(255, 255, 255, 0.12);
  --glass-border: rgba(255, 255, 255, 0.12);
  --glass-border-hover: rgba(255, 87, 34, 0.2);
  
  /* SHADOWS */
  --panel-shadow: 0 40px 100px rgba(0,0,0,0.8);
  --panel-shadow-hover: 0 50px 120px rgba(0,0,0,0.9);
  --glow-shadow: 0 0 30px var(--primary-glow);
  
  /* SPACING GRID (12-column system) */
  --gutter: 24px;
  --section-padding: 32px;
  --grid-gap: 24px;
  
  /* BORDER RADIUS */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 24px;
  --radius-xl: 32px;
  
  /* TRANSITIONS */
  --transition-fast: 0.2s ease;
  --transition-normal: 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  --transition-slow: 0.6s ease;
}

/* ============================================
   MEGAMP Q: UNIVERSAL DESIGN SYSTEM v4.0
   Industrial OS - Professional Aesthetic
   ============================================ */

:root {
  /* CORE COLOR PALETTE */
  --bg-primary: #0A0A0A;
  --bg-secondary: #050505;
  --bg-tertiary: #0F0F0F;
  --bg-deep: #050505;
  --bg-panel: rgba(13, 13, 17, 0.85);
  
  /* PRIMARY & ACCENTS */
  --primary: #FF5722;
  --primary-bright: #FF7043;
  --primary-dark: #E64A19;
  --primary-glow: rgba(255, 87, 34, 0.3);
  --primary-glow-bright: rgba(255, 87, 34, 0.6);
  
  /* SECONDARY ACCENTS */
  --accent: #00F2FF;
  --accent-glow: rgba(0, 242, 255, 0.3);
  --accent-dark: #00D4FF;
  
  /* STATUS COLORS */
  --success: #00FF41;
  --success-dark: #00E535;
  --success-glow: rgba(0, 255, 65, 0.3);
  --warning: #FFAB00;
  --warning-glow: rgba(255, 171, 0, 0.2);
  --error: #FF073A;
  --error-dark: #E60330;
  --error-glow: rgba(255, 7, 58, 0.2);
  
  /* TYPOGRAPHY */
  --text-main: #FFFFFF;
  --text-secondary: #E0E0E0;
  --text-dim: #888899;
  --text-dimmer: #666677;
  
  /* BORDERS & GLASS */
  --border: rgba(255, 255, 255, 0.08);
  --border-bright: rgba(255, 255, 255, 0.12);
  --glass-border: rgba(255, 255, 255, 0.12);
  --glass-border-hover: rgba(255, 87, 34, 0.2);
  
  /* SHADOWS */
  --panel-shadow: 0 40px 100px rgba(0,0,0,0.8);
  --panel-shadow-hover: 0 50px 120px rgba(0,0,0,0.9);
  --glow-shadow: 0 0 30px var(--primary-glow);
  
  /* SPACING GRID (12-column system) */
  --gutter: 24px;
  --section-padding: 32px;
  --grid-gap: 24px;
  
  /* BORDER RADIUS */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 24px;
  --radius-xl: 32px;
  
  /* TRANSITIONS */
  --transition-fast: 0.2s ease;
  --transition-normal: 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  --transition-slow: 0.6s ease;
}

/* ========== RESET & BASE STYLES ========== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body, #root {
  height: 100%;
  width: 100%;
}

body {
  background: var(--bg-deep);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
    'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
    sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
  letter-spacing: -0.01em;
  line-height: 1.6;
}

/* MONOSPACE FONT FOR DATA */
.mono, code, .kpi-value, table {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  letter-spacing: 0.05em;
}

/* ========== GRID LAYOUT SYSTEM ========== */
.grid-12 {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: var(--grid-gap);
}

.col-span-1 { grid-column: span 1; }
.col-span-2 { grid-column: span 2; }
.col-span-3 { grid-column: span 3; }
.col-span-4 { grid-column: span 4; }
.col-span-5 { grid-column: span 5; }
.col-span-6 { grid-column: span 6; }
.col-span-7 { grid-column: span 7; }
.col-span-8 { grid-column: span 8; }
.col-span-9 { grid-column: span 9; }
.col-span-10 { grid-column: span 10; }
.col-span-11 { grid-column: span 11; }
.col-span-12 { grid-column: span 12; }

.data-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  gap: var(--grid-gap);
  margin-top: 60px;
}

@media (max-width: 1024px) {
  .col-span-1 { grid-column: span 1; }
  .col-span-2 { grid-column: span 2; }
  .col-span-3 { grid-column: span 3; }
  .col-span-4 { grid-column: span 3; }
  .col-span-5 { grid-column: span 4; }
  .col-span-6 { grid-column: span 6; }
  .col-span-7 { grid-column: span 6; }
  .col-span-8 { grid-column: span 6; }
  .col-span-9 { grid-column: span 6; }
  .col-span-10 { grid-column: span 6; }
  .col-span-11 { grid-column: span 6; }
  .col-span-12 { grid-column: span 12; }
  
  .data-grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
}

@media (max-width: 640px) {
  .col-span-1 { grid-column: span 1; }
  .col-span-2 { grid-column: span 2; }
  .col-span-3 { grid-column: span 3; }
  .col-span-4 { grid-column: span 4; }
  .col-span-5 { grid-column: span 4; }
  .col-span-6 { grid-column: span 4; }
  .col-span-7 { grid-column: span 4; }
  .col-span-8 { grid-column: span 4; }
  .col-span-9 { grid-column: span 4; }
  .col-span-10 { grid-column: span 4; }
  .col-span-11 { grid-column: span 4; }
  .col-span-12 { grid-column: span 4; }
  
  .data-grid {
    grid-template-columns: 1fr;
  }
}

/* ========== APP LAYOUT ========== */
.app-container {
  min-height: 100vh;
  background: 
    radial-gradient(circle at 0% 0%, rgba(255, 87, 34, 0.08) 0%, transparent 40%),
    radial-gradient(circle at 100% 100%, rgba(0, 242, 255, 0.08) 0%, transparent 40%),
    url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4v-4H4v4H0v2h4v4h2v-4h4v-2H6zM36 4v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  display: flex;
  flex-direction: column;
}

.nav-bar {
  height: 90px;
  background: rgba(10, 10, 12, 0.95);
  backdrop-filter: blur(40px);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 60px;
  position: sticky;
  top: 0;
  z-index: 1000;
  box-shadow: 0 10px 40px rgba(0,0,0,0.5);
  gap: 40px;
}

.main-content {
  flex: 1;
  padding: 60px;
  max-width: 1700px;
  margin: 0 auto;
  width: 100%;
}

.footer {
  background: rgba(10, 10, 12, 0.95);
  backdrop-filter: blur(40px);
  border-top: 1px solid var(--border);
  padding: 40px 60px;
  text-align: center;
  font-size: 11px;
  color: var(--text-dim);
  letter-spacing: 0.15em;
  font-weight: 700;
  position: relative;
  z-index: 100;
}

.footer span {
  display: inline-block;
  margin: 0 20px;
  font-family: 'JetBrains Mono', monospace;
  color: var(--primary);
}

/* ========== GLASS PANEL COMPONENTS ========== */
.glass-panel {
  background: var(--bg-panel);
  backdrop-filter: blur(40px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--panel-shadow);
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}

.glass-panel::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  pointer-events: none;
}

.glass-panel:hover {
  border-color: var(--glass-border-hover);
  transform: translateY(-4px) scale(1.005);
  box-shadow: var(--panel-shadow-hover);
}

.glass-card {
  background: rgba(20, 20, 20, 0.8);
  border: 1px solid rgba(255, 87, 34, 0.1);
  border-radius: var(--radius-lg);
  padding: var(--section-padding);
  transition: all var(--transition-normal);
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.glass-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 87, 34, 0.2), transparent);
}

.glass-card:hover {
  border-color: rgba(255, 87, 34, 0.3);
  transform: translateY(-8px) scale(1.02);
  box-shadow: 0 20px 60px rgba(255, 87, 34, 0.1);
}

/* ========== BUTTONS ========== */
.btn-industrial {
  background: var(--primary);
  color: #000;
  border: none;
  padding: 14px 32px;
  border-radius: var(--radius-md);
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  cursor: pointer;
  font-size: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  transition: all var(--transition-fast);
  box-shadow: 0 0 20px var(--primary-glow);
  white-space: nowrap;
}

.btn-industrial:hover {
  background: var(--primary-bright);
  box-shadow: 0 0 40px var(--primary-glow-bright);
  transform: scale(1.05);
}

.btn-industrial:active {
  transform: scale(0.98);
}

.btn-industrial:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  pointer-events: none;
}

.btn-outline {
  background: transparent;
  border: 1px solid var(--primary);
  color: var(--primary);
  padding: 12px 24px;
  border-radius: var(--radius-md);
  font-weight: 800;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  cursor: pointer;
  transition: all var(--transition-fast);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.btn-outline:hover {
  background: rgba(255, 87, 34, 0.1);
  border-color: var(--primary-bright);
}

/* ========== INPUT FIELDS ========== */
.input-field {
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(255, 87, 34, 0.1);
  border-radius: var(--radius-md);
  border-bottom: 2px solid var(--primary);
  padding: 12px 16px;
  color: var(--text-main);
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  letter-spacing: 0.05em;
  transition: all var(--transition-fast);
  width: 100%;
}

.input-field::placeholder {
  color: var(--text-dimmer);
}

.input-field:focus {
  outline: none;
  background: rgba(0, 0, 0, 0.6);
  border-bottom-color: var(--primary-bright);
  box-shadow: 0 0 20px var(--primary-glow);
}

/* ========== STATUS BADGES ========== */
.status-badge {
  display: inline-block;
  padding: 8px 16px;
  border-radius: var(--radius-md);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-main);
  border: 1px solid var(--border);
  white-space: nowrap;
  transition: all var(--transition-fast);
}

.status-badge.status-active {
  background: rgba(0, 255, 65, 0.05);
  border: 1px solid rgba(0, 255, 65, 0.2);
  color: var(--success);
}

.status-badge.status-inactive {
  background: rgba(255, 7, 58, 0.05);
  border: 1px solid rgba(255, 7, 58, 0.2);
  color: var(--error);
}

.status-badge.status-warning {
  background: rgba(255, 171, 0, 0.05);
  border: 1px solid rgba(255, 171, 0, 0.2);
  color: var(--warning);
}

.dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--success);
  box-shadow: 0 0 15px var(--success);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* ========== LABELS & HEADERS ========== */
.section-label {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--text-dim);
  margin-bottom: 16px;
}

.cyber-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 60px;
  gap: 40px;
}

.cyber-header h1 {
  margin-bottom: 12px;
}

/* ========== KPI CARDS ========== */
.kpi-card {
  padding: var(--section-padding);
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.kpi-label {
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text-dim);
}

.kpi-value {
  font-size: 2.5rem;
  font-weight: 900;
  color: var(--primary);
  line-height: 1;
}

/* ========== TABLES ========== */
table {
  width: 100%;
  border-collapse: collapse;
}

th {
  padding: 24px;
  text-align: left;
  font-size: 11px;
  color: var(--text-dim);
  letter-spacing: 0.15em;
  font-weight: 900;
  text-transform: uppercase;
  background: rgba(255, 255, 255, 0.02);
  border-bottom: 1px solid var(--border);
}

td {
  padding: 20px 24px;
  font-size: 13px;
  border-bottom: 1px solid var(--border);
  transition: background var(--transition-fast);
}

tr:hover td {
  background: rgba(255, 87, 34, 0.02);
}

/* ========== BREADCRUMBS ========== */
.breadcrumbs {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
}

.breadcrumb-item {
  color: var(--text-dim);
  cursor: pointer;
  transition: color var(--transition-fast);
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.breadcrumb-item:hover {
  color: var(--primary);
}

.breadcrumb-item.active {
  color: var(--text-main);
}

.breadcrumb-separator {
  color: var(--text-dimmer);
  margin: 0 8px;
}

/* ========== UTILITY CLASSES ========== */
.space-y-6 > * + * {
  margin-top: 24px;
}

.space-y-8 > * + * {
  margin-top: 32px;
}

.space-y-10 > * + * {
  margin-top: 40px;
}

.space-y-12 > * + * {
  margin-top: 48px;
}

.space-y-16 > * + * {
  margin-top: 64px;
}

.space-x-4 {
  display: flex;
  gap: 16px;
}

.flex {
  display: flex;
}

.flex-col {
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.grid {
  display: grid;
}

.grid-cols-1 {
  grid-template-columns: 1fr;
}

.grid-cols-2 {
  grid-template-columns: repeat(2, 1fr);
  gap: var(--grid-gap);
}

.grid-cols-3 {
  grid-template-columns: repeat(3, 1fr);
  gap: var(--grid-gap);
}

.grid-cols-4 {
  grid-template-columns: repeat(4, 1fr);
  gap: var(--grid-gap);
}

.grid-cols-6 {
  grid-template-columns: repeat(6, 1fr);
  gap: var(--grid-gap);
}

.grid-cols-12 {
  grid-template-columns: repeat(12, 1fr);
  gap: var(--grid-gap);
}

.gap-6 {
  gap: 24px;
}

.gap-8 {
  gap: 32px;
}

.gap-10 {
  gap: 40px;
}

.mb-4 {
  margin-bottom: 16px;
}

.mb-6 {
  margin-bottom: 24px;
}

.mb-8 {
  margin-bottom: 32px;
}

.mt-6 {
  margin-top: 24px;
}

.mt-8 {
  margin-top: 32px;
}

/* RESPONSIVE */
@media (max-width: 1024px) {
  .nav-bar {
    padding: 0 40px;
    gap: 20px;
  }
  
  .main-content {
    padding: 40px;
  }
  
  .footer {
    padding: 32px 40px;
  }
  
  .grid-cols-2 {
    grid-template-columns: 1fr;
  }
  
  .grid-cols-3 {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .grid-cols-4 {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .grid-cols-6 {
    grid-template-columns: repeat(3, 1fr);
  }
  
  .lg\:col-span-3 {
    grid-column: span 12;
  }
  
  .lg\:col-span-5 {
    grid-column: span 12;
  }
  
  .lg\:col-span-7 {
    grid-column: span 12;
  }
  
  .lg\:col-span-9 {
    grid-column: span 12;
  }
}

@media (max-width: 640px) {
  .nav-bar {
    flex-direction: column;
    height: auto;
    padding: 20px;
    gap: 16px;
  }
  
  .main-content {
    padding: 24px 16px;
  }
  
  .footer {
    padding: 24px 16px;
  }
  
  .grid-cols-2 {
    grid-template-columns: 1fr;
  }
  
  .grid-cols-3 {
    grid-template-columns: 1fr;
  }
  
  .grid-cols-4 {
    grid-template-columns: 1fr;
  }
  
  .grid-cols-6 {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .data-grid {
    grid-template-columns: 1fr;
  }
  
  .cyber-header {
    flex-direction: column;
    align-items: flex-start;
  }
}
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 10px 30px var(--primary-glow);
}

.btn-industrial:hover {
  transform: translateY(-3px);
  box-shadow: 0 15px 45px var(--primary-glow);
  filter: brightness(1.2);
}

.btn-industrial:active { transform: translateY(-1px); }

.btn-outline {
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--border);
  color: #fff;
  padding: 12px 28px;
  border-radius: 12px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  cursor: pointer;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
}

.btn-outline:hover {
  border-color: var(--primary);
  color: var(--primary);
  background: rgba(255, 87, 34, 0.1);
  box-shadow: 0 0 25px rgba(255, 87, 34, 0.2);
}

.status-badge {
  padding: 6px 14px;
  border-radius: 6px;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--border);
  color: var(--text-dim);
}

.input-field {
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid var(--border);
  color: #fff;
  padding: 16px 20px;
  border-radius: 12px;
  font-family: 'JetBrains Mono', monospace;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  width: 100%;
  font-size: 13px;
}

.input-field:focus {
  border-color: var(--primary);
  background: rgba(0,0,0,0.6);
  box-shadow: 0 0 30px var(--primary-glow);
  outline: none;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.1); }
}

.dot {
  width: 8px; height: 8px; border-radius: 50%;
  animation: pulse 2s infinite ease-in-out;
}

/* Custom Scrollbar */
::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-track { background: var(--bg-deep); }
::-webkit-scrollbar-thumb { 
  background: rgba(255,255,255,0.05); 
  border-radius: 10px; 
  border: 2px solid var(--bg-deep);
}
::-webkit-scrollbar-thumb:hover { background: var(--border); }

.section-label {
  font-size: 10px;
  font-weight: 950;
  color: var(--primary);
  letter-spacing: 0.4em;
  text-transform: uppercase;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.section-label::after {
  content: '';
  height: 1px;
  flex: 1;
  background: linear-gradient(90deg, var(--border), transparent);
}

.sidebar-link {
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-dim);
  transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  cursor: pointer;
  position: relative;
}

.sidebar-link.active {
  background: rgba(255, 87, 34, 0.12);
  border-color: var(--primary);
  color: var(--primary);
  box-shadow: 0 10px 40px rgba(255, 87, 34, 0.15);
}

.sidebar-link.active::after {
  content: '';
  position: absolute;
  bottom: -1px; left: 20%; right: 20%; height: 2px;
  background: var(--primary);
  box-shadow: 0 0 15px var(--primary);
}
